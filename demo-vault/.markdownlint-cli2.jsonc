{
  // Scoped markdownlint config for the demo vault. Only one default rule is incompatible with what
  // These notes do; every other rule applies, as it does to the rest of the documentation.
  "config": {
    // `Rename heading backlinks.md` deliberately keeps Obsidian `[[wikilinks]]` -- they are the
    // Backlinks the heading rename rewrites -- and markdownlint parses one as an undefined shortcut
    // Reference link.
    "MD052": false,
    // A `title` in frontmatter is an Obsidian PROPERTY, not the document title, so it must not
    // Count as the note's top-level heading -- otherwise the required `# H1` reads as a second one.
    "MD025": { "front_matter_title": "" }
  }
}
